-- SEND COMMAND
-- =====================
local function SendCommand(cmd)
    cmd = cmd:match("^%s*(.-)%s*$")
    if not cmd or #cmd == 0 then return end
    pcall(function()
        local af = LP.PlayerGui.MainGui:FindFirstChild("AdminFrame")
        if not af then return end
        local tb = af:FindFirstChild("Command") and af.Command:FindFirstChild("TextBox")
        local enter = af:FindFirstChild("Enter")
        if not tb or not enter then return end
        tb.Text = cmd
        task.wait(0.08)
        pcall(function() enter:Activate() end)
        pcall(function() enter.MouseButton1Click:Fire() end)
    end)
end

