-- source: command dikirim via TextBox + Enter button di AdminFrame
-- kita wire langsung tanpa UI
-- format: ketik command di TextBox → klik Enter
-- =====================
local function SendCommand(cmd)
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return warn("[BYPASS] No PlayerGui") end
    local mg = pg:FindFirstChild("MainGui")
    if not mg then return warn("[BYPASS] No MainGui") end
    local af = mg:FindFirstChild("AdminFrame")
    if not af then return warn("[BYPASS] No AdminFrame") end

    local cmdFrame = af:FindFirstChild("Command")
    if not cmdFrame then return warn("[BYPASS] No Command frame") end
    local textbox = cmdFrame:FindFirstChild("TextBox")
    if not textbox then return warn("[BYPASS] No TextBox") end
    local enterBtn = af:FindFirstChild("Enter")
    if not enterBtn then return warn("[BYPASS] No Enter button") end

    -- set command text
    textbox.Text = cmd

    -- fire Enter button
    local ok, err = pcall(function()
        enterBtn:FindFirstChildOfClass("ClickDetector") -- just in case
        -- simulate click via Activated
        enterBtn.Activated:Connect(function() end) -- ensure listener exists
        -- fire MouseButton1Click
        local vgui = game:GetService("VirtualInputManager")
        if vgui then
            vgui:SendMouseButtonEvent(
                enterBtn.AbsolutePosition.X + enterBtn.AbsoluteSize.X/2,
                enterBtn.AbsolutePosition.Y + enterBtn.AbsoluteSize.Y/2,
                0, true, game, 0
            )
            task.wait(0.05)
            vgui:SendMouseButtonEvent(
                enterBtn.AbsolutePosition.X + enterBtn.AbsoluteSize.X/2,
                enterBtn.AbsolutePosition.Y + enterBtn.AbsoluteSize.Y/2,
                0, false, game, 0
            )
        end
    end)
    if not ok then
        -- fallback: fireclick
        pcall(function() enterBtn:FindFirstChildOfClass("GuiButton"):Activate() end)
        pcall(function() enterBtn:Activate() end)
    end
    print("[BYPASS] Command sent: " .. cmd)
end

